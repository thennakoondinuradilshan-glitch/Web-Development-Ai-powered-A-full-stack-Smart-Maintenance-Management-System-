import { useCallback, useEffect, useMemo, useState } from 'react';
import api from '../api';
import './MaintenanceRequests.css';

const PRIORITIES = ['LOW', 'MEDIUM', 'HIGH'];

const STATUSES = [
  'PENDING',
  'IN_PROGRESS',
  'COMPLETED'
];

const EMPTY_FORM = {
  title: '',
  description: '',
  equipment: '',
  priority: 'MEDIUM'
};

function MaintenanceRequests({ user: userProp }) {
  const [user, setUser] = useState(userProp || null);
  const [equipment, setEquipment] = useState([]);
  const [requests, setRequests] = useState([]);

  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [saving, setSaving] = useState(false);

  const [editingId, setEditingId] = useState('');
  const [updatingId, setUpdatingId] = useState('');
  const [deletingId, setDeletingId] = useState('');

  const [search, setSearch] = useState('');
  const [statusFilter, setStatusFilter] = useState('ALL');
  const [priorityFilter, setPriorityFilter] = useState('ALL');

  const [form, setForm] = useState(EMPTY_FORM);
  const [error, setError] = useState('');
  const [message, setMessage] = useState('');

  const isAdmin = user?.role === 'ADMIN';

  const canUpdateStatus =
    isAdmin || user?.role === 'TECHNICIAN';

  const loadData = useCallback(async (showLoading = true) => {
    if (showLoading) {
      setLoading(true);
    } else {
      setRefreshing(true);
    }

    setError('');

    try {
      const results = await Promise.all([
        userProp
          ? Promise.resolve({ data: { user: userProp } })
          : api.get('/auth/me'),
        api.get('/equipment'),
        api.get('/maintenance')
      ]);

      setUser(results[0].data.user);

      const equipmentData = results[1].data;
      const requestData = results[2].data;

      setEquipment(
        Array.isArray(equipmentData)
          ? equipmentData
          : equipmentData.equipment || []
      );

      setRequests(
        Array.isArray(requestData)
          ? requestData
          : requestData.requests || []
      );
    } catch (err) {
      setError(
        err.response?.data?.message ||
        'Unable to load maintenance data. Please try again.'
      );
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  }, [userProp]);

  useEffect(() => {
    loadData();
  }, [loadData]);

  const stats = useMemo(() => ({
    total: requests.length,

    pending: requests.filter(
      item => item.status === 'PENDING'
    ).length,

    inProgress: requests.filter(
      item => item.status === 'IN_PROGRESS'
    ).length,

    completed: requests.filter(
      item => item.status === 'COMPLETED'
    ).length
  }), [requests]);

  const filteredRequests = useMemo(() => {
    const query = search.trim().toLowerCase();

    return requests.filter(request => {
      const equipmentItem =
        typeof request.equipment === 'object'
          ? request.equipment
          : equipment.find(
              item => item._id === request.equipment
            );

      const text = [
        request.title,
        request.description,
        equipmentItem?.name,
        equipmentItem?.location,
        request.createdBy?.name
      ]
        .filter(Boolean)
        .join(' ')
        .toLowerCase();

      return (
        (!query || text.includes(query)) &&
        (statusFilter === 'ALL' ||
          request.status === statusFilter) &&
        (priorityFilter === 'ALL' ||
          request.priority === priorityFilter)
      );
    });
  }, [
    requests,
    equipment,
    search,
    statusFilter,
    priorityFilter
  ]);

  function handleChange(event) {
    const { name, value } = event.target;

    setForm(previous => ({
      ...previous,
      [name]: value
    }));
  }

  function resetForm() {
    setForm(EMPTY_FORM);
    setEditingId('');
    setError('');
  }

  async function handleSubmit(event) {
    event.preventDefault();

    if (!isAdmin) {
      setError('Only administrators can create or edit requests.');
      return;
    }

    if (!form.title.trim() || !form.description.trim()) {
      setError('Please complete the required fields.');
      return;
    }

    if (!editingId && !form.equipment) {
      setError('Please select equipment.');
      return;
    }

    setSaving(true);
    setError('');
    setMessage('');

    try {
      if (editingId) {
        const response = await api.patch(
          `/maintenance/${editingId}`,
          {
            title: form.title.trim(),
            description: form.description.trim(),
            priority: form.priority
          }
        );

        const updated = response.data.request;

        setRequests(previous =>
          previous.map(item =>
            item._id === editingId
              ? updated || {
                  ...item,
                  ...form
                }
              : item
          )
        );

        setMessage('Maintenance request updated successfully.');
      } else {
        await api.post('/maintenance', {
          title: form.title.trim(),
          description: form.description.trim(),
          equipment: form.equipment,
          priority: form.priority
        });

        setMessage('Maintenance request created successfully.');

        await loadData(false);
      }

      setForm(EMPTY_FORM);
      setEditingId('');
    } catch (err) {
      setError(
        err.response?.data?.message ||
        'Unable to save the maintenance request.'
      );
    } finally {
      setSaving(false);
    }
  }

  function handleEdit(request) {
    if (!isAdmin) return;

    setEditingId(request._id);

    setForm({
      title: request.title || '',
      description: request.description || '',
      equipment:
        typeof request.equipment === 'object'
          ? request.equipment?._id || ''
          : request.equipment || '',
      priority: request.priority || 'MEDIUM'
    });

    setError('');
    setMessage('');

    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });
  }

  async function handleStatusChange(id, status) {
    if (!canUpdateStatus) return;

    setUpdatingId(id);
    setError('');
    setMessage('');

    try {
      const response = await api.patch(
        `/maintenance/${id}`,
        { status }
      );

      const updated = response.data.request;

      setRequests(previous =>
        previous.map(item =>
          item._id === id
            ? updated || { ...item, status }
            : item
        )
      );

      setMessage('Request status updated successfully.');
    } catch (err) {
      setError(
        err.response?.data?.message ||
        'Unable to update request status.'
      );
    } finally {
      setUpdatingId('');
    }
  }

  async function handleDelete(id) {
    if (!isAdmin) return;

    if (!window.confirm(
      'Are you sure you want to delete this request?'
    )) {
      return;
    }

    setDeletingId(id);
    setError('');
    setMessage('');

    try {
      await api.delete(`/maintenance/${id}`);

      setRequests(previous =>
        previous.filter(item => item._id !== id)
      );

      if (editingId === id) {
        resetForm();
      }

      setMessage('Maintenance request deleted successfully.');
    } catch (err) {
      setError(
        err.response?.data?.message ||
        'Unable to delete this request.'
      );
    } finally {
      setDeletingId('');
    }
  }

  function getEquipment(request) {
    if (typeof request.equipment === 'object') {
      return request.equipment;
    }

    return equipment.find(
      item => item._id === request.equipment
    );
  }

  function formatDate(date) {
    if (!date) return 'Not available';

    const parsedDate = new Date(date);

    return Number.isNaN(parsedDate.getTime())
      ? 'Not available'
      : parsedDate.toLocaleString();
  }

  if (loading) {
    return (
      <main className="mr-page">
        <div className="mr-loading">
          <div className="mr-spinner" />
          <h2>Loading maintenance requests</h2>
          <p>Please wait while we load your data.</p>
        </div>
      </main>
    );
  }

  if (!user) {
    return (
      <main className="mr-page">
        <div className="mr-empty">
          <h2>Unable to verify your session</h2>
          <p>{error || 'Please log in again.'}</p>
          <button
            className="mr-btn mr-primary"
            onClick={() => loadData()}
          >
            Try Again
          </button>
        </div>
      </main>
    );
  }

  return (
    <main className="mr-page">

      <header className="mr-header">
        <div>
          <span className="mr-eyebrow">
            OPERATIONS / MAINTENANCE
          </span>

          <h1>Maintenance Requests</h1>

          <p>
            Track service issues, manage repairs and
            monitor maintenance progress.
          </p>
        </div>

        <div className="mr-header-actions">
          <span className="mr-role">
            {user.role} ACCESS
          </span>

          <button
            className="mr-btn mr-secondary"
            onClick={() => loadData(false)}
            disabled={refreshing}
          >
            {refreshing ? 'Refreshing...' : '↻ Refresh'}
          </button>
        </div>
      </header>

      {error && (
        <div className="mr-alert mr-error" role="alert">
          <strong>Error:</strong> {error}
          <button onClick={() => setError('')}>×</button>
        </div>
      )}

      {message && (
        <div className="mr-alert mr-success" role="status">
          <span>✓ {message}</span>
          <button onClick={() => setMessage('')}>×</button>
        </div>
      )}

      <section className="mr-stats">

        <article className="mr-stat-card">
          <div className="mr-stat-icon blue">▤</div>
          <p>Total Requests</p>
          <h2>{stats.total}</h2>
          <span>All recorded requests</span>
        </article>

        <article className="mr-stat-card">
          <div className="mr-stat-icon amber">◷</div>
          <p>Pending</p>
          <h2>{stats.pending}</h2>
          <span>Waiting for action</span>
        </article>

        <article className="mr-stat-card">
          <div className="mr-stat-icon purple">↻</div>
          <p>In Progress</p>
          <h2>{stats.inProgress}</h2>
          <span>Currently being repaired</span>
        </article>

        <article className="mr-stat-card">
          <div className="mr-stat-icon green">✓</div>
          <p>Completed</p>
          <h2>{stats.completed}</h2>
          <span>Successfully completed</span>
        </article>

      </section>

      {isAdmin && (
        <section className="mr-panel">

          <div className="mr-panel-heading">
            <div className="mr-heading-icon">＋</div>

            <div>
              <h2>
                {editingId
                  ? 'Edit Maintenance Request'
                  : 'Create Maintenance Request'}
              </h2>

              <p>
                Record a new issue or update an existing request.
              </p>
            </div>
          </div>

          <form onSubmit={handleSubmit}>

            <div className="mr-form-grid">

              <label>
                Request Title *
                <input
                  name="title"
                  value={form.title}
                  onChange={handleChange}
                  placeholder="e.g. Air conditioner not cooling"
                  maxLength={150}
                  required
                />
              </label>

              <label>
                Equipment *
                <select
                  name="equipment"
                  value={form.equipment}
                  onChange={handleChange}
                  disabled={Boolean(editingId)}
                  required={!editingId}
                >
                  <option value="">Select equipment</option>

                  {equipment.map(item => (
                    <option key={item._id} value={item._id}>
                      {item.name} — {item.location}
                    </option>
                  ))}
                </select>

                {editingId && (
                  <small>
                    Equipment cannot be changed while editing.
                  </small>
                )}
              </label>

              <label className="mr-full">
                Description *
                <textarea
                  name="description"
                  value={form.description}
                  onChange={handleChange}
                  placeholder="Describe the maintenance issue..."
                  rows={4}
                  maxLength={2000}
                  required
                />
              </label>

              <label>
                Priority
                <select
                  name="priority"
                  value={form.priority}
                  onChange={handleChange}
                >
                  {PRIORITIES.map(priority => (
                    <option key={priority} value={priority}>
                      {priority}
                    </option>
                  ))}
                </select>
              </label>

            </div>

            <div className="mr-form-actions">
              <button
                className="mr-btn mr-primary"
                type="submit"
                disabled={saving}
              >
                {saving
                  ? 'Saving...'
                  : editingId
                    ? 'Save Changes'
                    : '＋ Create Request'}
              </button>

              {editingId && (
                <button
                  type="button"
                  className="mr-btn mr-secondary"
                  onClick={resetForm}
                >
                  Cancel
                </button>
              )}
            </div>

          </form>
        </section>
      )}

      <section className="mr-register">

        <div className="mr-register-heading">
          <div>
            <h2>
              Request Register
              <span className="mr-count">
                {filteredRequests.length}
              </span>
            </h2>

            <p>Search and review all maintenance activity.</p>
          </div>
        </div>

        <div className="mr-toolbar">

          <input
            type="search"
            placeholder="⌕ Search requests, equipment or location..."
            value={search}
            onChange={event => setSearch(event.target.value)}
            aria-label="Search maintenance requests"
          />

          <select
            value={statusFilter}
            onChange={event => setStatusFilter(event.target.value)}
            aria-label="Filter by status"
          >
            <option value="ALL">All Statuses</option>

            {STATUSES.map(status => (
              <option key={status} value={status}>
                {status.replace(/_/g, ' ')}
              </option>
            ))}
          </select>

          <select
            value={priorityFilter}
            onChange={event => setPriorityFilter(event.target.value)}
            aria-label="Filter by priority"
          >
            <option value="ALL">All Priorities</option>

            {PRIORITIES.map(priority => (
              <option key={priority} value={priority}>
                {priority}
              </option>
            ))}
          </select>

        </div>

        {filteredRequests.length === 0 ? (
          <div className="mr-empty">
            <div className="mr-empty-symbol">▤</div>
            <h3>No requests found</h3>
            <p>
              Try different filters or create a new request.
            </p>
          </div>
        ) : (

          <div className="mr-request-list">

            {filteredRequests.map(request => {
              const equipmentItem = getEquipment(request);
              const status = request.status || 'PENDING';
              const priority = request.priority || 'MEDIUM';

              return (
                <article
                  className="mr-request-card"
                  key={request._id}
                >

                  <div className="mr-request-main">

                    <div className="mr-request-top">
                      <div>
                        <span className="mr-request-id">
                          REQUEST #{String(request._id).slice(-6).toUpperCase()}
                        </span>

                        <h3>{request.title}</h3>
                      </div>

                      <span className={`mr-badge priority-${priority.toLowerCase()}`}>
                        {priority} PRIORITY
                      </span>
                    </div>

                    <p className="mr-description">
                      {request.description}
                    </p>

                    <div className="mr-details">

                      <div>
                        <span>Equipment</span>
                        <strong>
                          {equipmentItem?.name || 'Unknown equipment'}
                        </strong>
                      </div>

                      <div>
                        <span>Location</span>
                        <strong>
                          {equipmentItem?.location || 'Not specified'}
                        </strong>
                      </div>

                      <div>
                        <span>Requested By</span>
                        <strong>
                          {request.createdBy?.name || 'Unknown'}
                        </strong>
                      </div>

                      <div>
                        <span>Created Date</span>
                        <strong>{formatDate(request.createdAt)}</strong>
                      </div>

                    </div>
                  </div>

                  <aside className="mr-request-side">

                    <span className="mr-side-label">
                      CURRENT STATUS
                    </span>

                    <span className={`mr-badge status-${status.toLowerCase()}`}>
                      ● {status.replace(/_/g, ' ')}
                    </span>

                    {canUpdateStatus && (
                      <label className="mr-status-label">
                        Update Status

                        <select
                          value={status}
                          disabled={updatingId === request._id}
                          onChange={event =>
                            handleStatusChange(
                              request._id,
                              event.target.value
                            )
                          }
                        >
                          {STATUSES.map(item => (
                            <option key={item} value={item}>
                              {item.replace(/_/g, ' ')}
                            </option>
                          ))}
                        </select>
                      </label>
                    )}

                    {isAdmin && (
                      <div className="mr-card-actions">
                        <button
                          className="mr-btn mr-secondary"
                          onClick={() => handleEdit(request)}
                        >
                          Edit
                        </button>

                        <button
                          className="mr-btn mr-delete"
                          disabled={deletingId === request._id}
                          onClick={() => handleDelete(request._id)}
                        >
                          {deletingId === request._id
                            ? 'Deleting...'
                            : 'Delete'}
                        </button>
                      </div>
                    )}

                  </aside>

                </article>
              );
            })}

          </div>
        )}

      </section>

      <footer className="mr-footer">
        <span>Smart Maintenance Management System</span>
        <span>
          Showing {filteredRequests.length} of {requests.length} requests
        </span>
      </footer>

    </main>
  );
}

export default MaintenanceRequests;